<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Arnés de la cola local. Compila los mismos archivos que la app, no una copia.
    ColaOperaciones no referencia MAUI, así que corre en un proceso de consola.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Breb.ColaPrueba</AssemblyName>
    <RootNamespace>Breb.ColaPrueba</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Breb.App\Modelos\OperacionPendiente.cs" Link="Compartido\OperacionPendiente.cs" />
    <Compile Include="..\Breb.App\Servicios\ColaOperaciones.cs" Link="Compartido\ColaOperaciones.cs" />
  </ItemGroup>

</Project>
