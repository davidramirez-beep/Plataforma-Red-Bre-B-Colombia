<?xml version="1.0" encoding="utf-8"?>
<!--
  Solo Debug, para el emulador del laboratorio (HTTP a 10.0.2.2).
  Release usa network_security_config.xml y no permite claro.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
