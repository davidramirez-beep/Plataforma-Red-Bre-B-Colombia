# Copie este archivo a .env en el servidor y cambie los tres secretos.
# .env no se commitea. No use guest, dev_only_password ni la clave JWT del laboratorio.
# No ponga aquí la IP pública ni abra estos servicios a Internet: el compose
# los ata a 127.0.0.1.

POSTGRES_USER=breb
POSTGRES_PASSWORD=CAMBIE-esta-clave-de-postgres
POSTGRES_DB=brebcuentas

RABBITMQ_USER=breb
RABBITMQ_PASSWORD=CAMBIE-esta-clave-de-rabbit

# Mínimo 32 caracteres. No es "clave-de-laboratorio-no-usar-en-produccion-32+".
JWT_CLAVE_FIRMA=CAMBIE-esta-clave-jwt-de-32-caracteres-o-mas
